# Environment Configuration Template
PROJECT_NAME="JanSeva AI Grievance System"
ENVIRONMENT="development"
DEBUG=True

# Database (Supabase PostgreSQL in production, SQLite in local dev)
DATABASE_URL="sqlite+aiosqlite:///./grievance_system.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres"

# JWT Security
SECRET_KEY="replace-with-a-random-64-character-production-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ANONYMOUS_SESSION_EXPIRE_DAYS=30

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://your-app.vercel.app"]

# Storage Configuration (Supabase or Local)
STORAGE_TYPE="local" # 'local' or 'supabase'
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_STORAGE_BUCKET="complaint-attachments"
UPLOAD_DIR="./uploads"

# Email Provider Configuration ('mock', 'smtp', or 'resend')
EMAIL_PROVIDER="mock"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@mp.gov.in"
RESEND_API_KEY=""

# Gemini AI Optional Layer
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Required only when running the demo seeder. Never commit actual passwords.
SEED_CITIZEN_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_OFFICER_PASSWORD=""
