# Environment Configuration Template
PROJECT_NAME="JanSeva AI Grievance System"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# Local development (SQLite):
# DATABASE_URL="sqlite+aiosqlite:///./grievance_system.db"

# Production Least-Privilege PostgreSQL Role Separation:
# 1. Runtime Application Role (e.g. janseva_app):
#    Granted only required DML. Strictly NO DDL, no table ownership, and append-only on audit tables.
# DATABASE_URL="postgresql+asyncpg://janseva_app:CHANGE_ME_APP_PASSWORD@localhost:5432/janseva_db"
#
# 2. Migration / Administration Role (e.g. janseva_migrator or postgres admin):
#    Dedicated role with DDL privileges used solely for Alembic migrations and database administration.
# MIGRATION_DATABASE_URL="postgresql+asyncpg://janseva_migrator:CHANGE_ME_MIGRATOR_PASSWORD@localhost:5432/janseva_db"

# JWT Security
SECRET_KEY="replace-with-a-random-64-character-production-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ANONYMOUS_SESSION_EXPIRE_DAYS=30

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://your-app.vercel.app"]

# Storage Configuration (Supabase or Local)
STORAGE_TYPE="local" # 'local' or 'supabase'
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_STORAGE_BUCKET="complaint-attachments"
UPLOAD_DIR="./uploads"

# Email Provider Configuration ('mock', 'smtp', or 'resend')
EMAIL_PROVIDER="mock"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@mp.gov.in"
RESEND_API_KEY=""

# Gemini AI Optional Layer
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Required only when running the demo seeder. Never commit actual passwords.
SEED_CITIZEN_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_OFFICER_PASSWORD=""
